using Microsoft.EntityFrameworkCore;
namespace <<namespace>>;
public abstract partial class CustomDbContext : DbContext
{
    public string Schema = "public";
    public static readonly AsyncLocal<string> _asyncThread = new();
    protected CustomDbContext(DbContextOptions options) : base(options) { }
